# Copy this file to .env and replace only the placeholders.
GEMINI_API_KEY=replace_with_your_gemini_key
GROQ_API_KEY=replace_with_your_groq_key
GEMINI_MODEL=gemini-3.1-flash-lite
GROQ_MODEL=openai/gpt-oss-20b

# Optional: for a model not listed in tracker.py, set BOTH of its
# standard paid-tier prices (USD per million text tokens).
# GEMINI_INPUT_PRICE_PER_M=0.25
# GEMINI_OUTPUT_PRICE_PER_M=1.50
# GROQ_INPUT_PRICE_PER_M=0.075
# GROQ_OUTPUT_PRICE_PER_M=0.30
